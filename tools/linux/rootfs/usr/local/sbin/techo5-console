#!/bin/sh
# Root shell on the USB serial port (CDC ACM, a COM port on the host), under
# busybox init (inittab respawn). Waits for the device node, which appears once
# the gadget is bound (boot.sh or techo5-usb, while USB debugging is on). init
# already made this process a session leader, so opening the port makes it the
# controlling terminal; no setsid here — busybox's setsid would fork, the
# respawn entry would exit at once and init would start another shell every
# cycle, piling them up.
#
# With a root password set (t5_root_pw) it asks for it, through login. Not
# during the installer's first boot (/run/techo5/usb_install), which the
# installer watches over this port; it closes the port and this shell after.
while [ ! -c /dev/ttyGS0 ]; do sleep 3; done
echo $$ > /run/techo5/console.pid
if [ -e /run/techo5/root_pw_on ] && [ ! -e /run/techo5/usb_install ]; then
	exec /bin/login < /dev/ttyGS0 > /dev/ttyGS0 2>&1
fi
exec /bin/sh -l < /dev/ttyGS0 > /dev/ttyGS0 2>&1
