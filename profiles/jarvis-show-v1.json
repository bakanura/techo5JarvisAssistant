{
  "product": "jarvis-show-v1",
  "version": 1,
  "boards": ["crown", "checkers"],
  "assistant": {
    "wake_word": "hey_jarvis",
    "wake_fallbacks": ["okay_nabu", "alexa"],
    "wake_slots": 1,
    "brain_mode": "automatic",
    "follow_up_seconds": 6,
    "automatic_follow_ups": 2,
    "follow_up_tone": false,
    "stop_threshold": 0.55
  },
  "display": {
    "mode": "streamed",
    "path": "/jarvis-display",
    "idle": true,
    "headerless": true,
    "sidebarless": true
  },
  "security": {
    "house_announcements": "signed-only",
    "sip_transport": "tls",
    "sip_media": "srtp",
    "drop_in_default": false
  }
}
